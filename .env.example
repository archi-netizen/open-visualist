# Required
OPENAI_API_KEY=your_key_here

# Optional — Openverse works anonymously without these (more rate-limited).
# Register an app at https://api.openverse.org to get higher limits.
OPENVERSE_CLIENT_ID=your_id_here
OPENVERSE_CLIENT_SECRET=your_secret_here

# Optional — override if gpt-3.5-turbo is retired or you want a different model.
# OPENAI_EXTRACTION_MODEL=gpt-3.5-turbo

# Optional — used by web/ to find the API. Defaults to http://localhost:8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000
